<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Turns the screen off near the ear during calls (normal permission,
         granted at install). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application>
        <!-- Handles answer, decline and hang up buttons on call notifications.
             Not exported, so only this app's own notifications can use it. -->
        <receiver
            android:name="dev.telephonykit.telephony_kit.CallActionReceiver"
            android:exported="false" />
    </application>
    <!-- Other permissions and the in-call and call screening services are
         declared by the app, not the library. See the README. -->
</manifest>
